{
  "name": "covo",
  "version": "0.0.1",
  "private": true,
  "description": "Open-source AI coworkers that run safely on your own Mac.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/app/tsconfig.json",
    "check": "bun run lint && bun run typecheck && bun test",
    "covo": "bun apps/cli/src/index.ts",
    "app:build": "bun apps/app/build.ts",
    "app:dev": "bun apps/app/build.ts --watch",
    "mac:build": "bash apps/mac/build.sh",
    "mac:test": "swift test --package-path apps/mac"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
